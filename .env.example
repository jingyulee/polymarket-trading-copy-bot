# Wallet
# Target wallet to monitor and the local wallet used to copy trades.
TARGET_WALLET=0xba264376d6fef08f23a44db4153d12d47f5f23c9
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
RPC_URL=https://polygon-rpc.com
POLYMARKET_GEO_TOKEN=

# Wallet auth mode: 0=EOA, 1=Poly Proxy, 2=Poly Polymorphic.
SIG_TYPE=0
PROXY_WALLET_ADDRESS=
# ── CLOB（DRY_RUN=false 才需要）─────────────────────────────
CLOB_API_URL=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=


# Trading
# Core copy sizing and order placement behavior.
POSITION_MULTIPLIER=0.1
MAX_TRADE_SIZE=100
MIN_TRADE_SIZE=1
SLIPPAGE_TOLERANCE=0.02
ORDER_TYPE=FOK

# v32 sharky filters and execution safeguards.
DRY_RUN=true
COPY_ONLY_BUY=true
MIN_SOURCE_PRICE=0.97
MAX_SOURCE_PRICE=0.999
MAX_SOURCE_TRADE_AGE_MS=35000
MIN_SOURCE_TRADE_USD=2
MAX_USD_PER_ORDER=5
MARKET_SCOPE=crypto-only
CRYPTO_KEYWORDS=btc,bitcoin,eth,ethereum,sol,solana,xrp,doge,dogecoin,bnb,hyperliquid,hype,avax,pepe,sui,arb
ONE_TRADE_PER_MARKET=true
MAX_PRICE_DEVIATION=0.01
MIN_LIQUIDITY=5
MAX_ENTRY_PRICE_GAP_BPS=10
ENABLE_MAKER_FALLBACK=false
MAKER_FALLBACK_PRICE_OFFSET_BPS=10
MAKER_FALLBACK_TTL_MS=15000
MIN_BEST_BID_FOR_MAKER_FALLBACK=0.10
MAX_SPREAD_FOR_ENTRY=0.05
MIN_ASKS_DEPTH=1
ONLY_HIGH_LIQUIDITY_SYMBOLS=true
ENABLE_NO_ASKS_FALLBACK=true
NO_ASKS_FALLBACK_ORDER_TYPE=FAK
MAX_FALLBACK_PRICE_GAP_BPS=300

# Risk
# Set to 0 to disable the cap.
MAX_SESSION_NOTIONAL=0
MAX_PER_MARKET_NOTIONAL=0

# Monitoring
# REST polling and optional websocket subscriptions.
POLL_INTERVAL=2000
USE_WEBSOCKET=true
USE_USER_CHANNEL=false
SOURCE_TRADER_WHITELIST=
WS_ASSET_IDS=
WS_MARKET_IDS=

# Orderbook prewarm (latency optimization)
ENABLE_ORDERBOOK_PREWARM=true
PREWARM_SYMBOLS=btc,bitcoin,eth,ethereum,sol,solana
PREWARM_MATCH_MODE=strict
ORDERBOOK_CACHE_TTL_MS=5000

# Redeem monitoring
REDEEM_CHECK_INTERVAL_MS=60000
SETTLEMENT_CHECK_INTERVAL_MS=60000

# Telegram
# Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REDEEM_CHAT_ID=
