# Wallet
TARGET_WALLET=0xba264376d6fef08f23a44db4153d12d47f5f23c9
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
RPC_URL=https://polygon.drpc.org
POLYMARKET_GEO_TOKEN=
SIG_TYPE=0
PROXY_WALLET_ADDRESS=

# CLOB
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Trading
DRY_RUN=false
COPY_ONLY_BUY=true
POSITION_MULTIPLIER=0.2
MAX_TRADE_SIZE=100
MIN_TRADE_SIZE=1
MAX_USD_PER_ORDER=3
ORDER_TYPE=FOK
SLIPPAGE_TOLERANCE=0.01
EXECUTION_FIXED_PRICE=0.99

# Signal
ENABLE_SIGNAL_TRIGGER=true
SIGNAL_WINDOW_MS=8000
SIGNAL_MIN_TRADE_COUNT=2
SIGNAL_MIN_CUMULATIVE_USD=50
SINGLE_SIGNAL_TRIGGER_USD=20
SIGNAL_REQUIRE_BUY_ONLY=true

# Execution
MAX_SOURCE_TRADE_AGE_MS=12000
MVP_MAX_PRICE_DRIFT_BPS=20
ONE_TRADE_PER_MARKET=true

# Market
MARKET_SCOPE=crypto-only
CRYPTO_KEYWORDS=btc,bitcoin,eth,ethereum,sol,solana,xrp,DOGE,Dogecoin,BNB,Hyperliquid,Hype,AVAX,Pepe,SUI,ARB

# Lock / Retry
MARKET_SHORT_LOCK_MS=5000
MARKET_MAX_RETRY_PER_WINDOW=1
MARKET_RETRY_WINDOW_MS=15000

# Risk
MAX_SESSION_NOTIONAL=0
MAX_PER_MARKET_NOTIONAL=0

# Monitoring
POLL_INTERVAL=1000
USE_WEBSOCKET=true
SOURCE_TRADER_WHITELIST=

# Orderbook
ENABLE_ORDERBOOK_PREWARM=true
PREWARM_SYMBOLS=btc,bitcoin,eth,ethereum,sol,solana,bnb,xrp,Hyperliquid,Dogecoin
PREWARM_MATCH_MODE=loose
ORDERBOOK_CACHE_TTL_MS=3000

# Redeem
REDEEM_CHECK_INTERVAL_MS=60000
SETTLEMENT_CHECK_INTERVAL_MS=60000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REDEEM_CHAT_ID=
